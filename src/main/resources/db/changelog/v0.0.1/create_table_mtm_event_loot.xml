<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create_table_mtm_event_loot_seq" author="sd">
        <preConditions>
            <not>
                <sequenceExists sequenceName="mtm_event_loot_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="mtm_event_loot_seq"/>
    </changeSet>

    <changeSet id="create_table_mtm_event_loot" author="sd">
        <preConditions>
            <not>
                <tableExists tableName="mtm_event_loot"/>
            </not>
        </preConditions>
        <createTable tableName="mtm_event_loot">
            <column name="id" type="bigint" defaultValueSequenceNext="mtm_event_loot_seq" remarks="mtm_event_loot_id">
                <constraints primaryKey="true" primaryKeyName="mtm_event_loot_id_pk"/>
            </column>
            <column name="event_id" type="bigint" remarks="event_id mapping">
                <constraints nullable="false" deleteCascade="true"/>
            </column>
            <column name="loot_id" type="bigint" remarks="loot_id mapping">
                <constraints nullable="false" deleteCascade="true"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="mtm_event_loot"
                                 baseColumnNames="event_id"
                                 constraintName="event_loot_event_id_fk"
                                 referencedTableName="event"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="mtm_event_loot"
                                 baseColumnNames="loot_id"
                                 constraintName="event_loot_loot_id_fk"
                                 referencedTableName="loot"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

